#!/bin/zsh
# fake claude: logs args + config dir; auth state lives in $CLAUDE_CONFIG_DIR/.stub-auth
printf '%s %s\n' "claude CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR" "$*" >> "${STUB_LOG:-/dev/null}"
d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [[ "$1 $2" == "auth status" ]]; then
  if [[ -f "$d/.stub-status-garbage" ]]; then echo "not json"; exit 1; fi   # simulates a failed/timed-out check
  if [[ -f "$d/.stub-auth" ]]; then cat "$d/.stub-auth"; else echo '{"loggedIn": false}'; exit 1; fi
  exit 0
fi
if [[ "$1 $2" == "auth logout" ]]; then
  rm -f "$d/.stub-auth"; exit 0
fi
if [[ "$1 $2" == "auth login" && -f "$d/.stub-login-hang" ]]; then
  exec sleep "$(<"$d/.stub-login-hang")"   # simulates a browser that never finishes
fi
if [[ "$1 $2" == "auth login" ]]; then
  [[ -f "$d/.stub-login-email" ]] && printf '{"loggedIn": true, "email": "%s"}\n' "$(<"$d/.stub-login-email")" > "$d/.stub-auth"
  exit 0
fi
exit 0
